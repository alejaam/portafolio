---
import type { Content } from '../content';

interface Props {
  content: Content;
}

const { contact } = Astro.props.content;
---

<section id="contact" class="row" aria-labelledby="contact-title">
  <h2 id="contact-title" class="sr-only">{contact.heading}</h2>
  <figure class="cell cell--alt span-4 md-span-6 terminal">
    <pre aria-hidden="true">{contact.terminal.lines.join('\n')}</pre>
    <figcaption class="sr-only">{contact.terminal.alt}</figcaption>
  </figure>
  <div class="cell cell--ink span-5 md-span-6 email">
    <p class="label">{contact.emailLabel}</p>
    <a class="email__link" href={`mailto:${contact.email}`}>{contact.email}</a>
  </div>
  <ul class="stack-col span-3 md-span-12 links" aria-label={contact.linksLabel}>
    {
      contact.links.map((link) => (
        <li>
          <a
            class="cell links__item"
            href={link.url}
            {...(link.external ? { rel: 'me' } : { type: 'application/pdf' })}
          >
            <span>{link.label}</span>
            <span aria-hidden="true">{link.external ? '↗' : '↓'}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .terminal pre {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .email {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 220px;
  }
  .email__link {
    display: inline-block;
    min-height: var(--touch);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .email__link:hover {
    text-decoration-thickness: 4px;
  }

  .links li {
    display: grid;
  }
  .links__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--touch);
    padding-block: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .links__item:hover {
    background: var(--c-accent);
  }
  .links__item:focus-visible {
    outline-offset: -6px;
  }

  @media (max-width: 720px) {
    .email {
      min-height: 0;
    }
  }
</style>
