---
import type { Content } from '../content';

interface Props {
  content: Content;
}

const { projects } = Astro.props.content;
---

<section class="row" aria-labelledby="projects-title">
  <h2 id="projects-title" class="sr-only">{projects.heading}</h2>
  {
    projects.items.map((project) => (
      <a class="cell span-3 md-span-6 project" href={project.url}>
        <span class="label">{project.label}</span>
        <span class="title-md project__name">{project.name}</span>
        <span class="project__desc">{project.description}</span>
        <span class="mono muted project__stack">{project.stack}</span>
      </a>
    ))
  }
</section>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 260px;
    text-decoration: none;
  }
  .project:hover {
    background: var(--c-cell-alt);
  }
  .project:hover .project__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .project:focus-visible {
    outline-offset: -6px;
  }
  .project__name {
    margin-top: 8px;
  }
  .project__stack {
    margin-top: auto;
    padding-top: 12px;
    font-size: var(--fs-label);
    line-height: 1.45;
  }

  @media (max-width: 720px) {
    .project {
      min-height: 0;
    }
  }
</style>
