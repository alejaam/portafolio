---
import type { Content } from '../content';

interface Props {
  content: Content;
}

const { featured, stats } = Astro.props.content;
---

<section id="projects" class="row" aria-labelledby="featured-title">
  <article class="cell span-8 md-span-12 featured">
    <div class="featured__meta">
      <p class="label">{featured.label}</p>
      <p class="label">{featured.status}</p>
    </div>
    <h2 id="featured-title" class="title-lg">{featured.name}</h2>
    <p class="featured__desc">{featured.description}</p>
    <ol class="stages" aria-label={featured.stagesLabel}>
      {
        featured.stages.map((stage) => (
          <li class:list={['stages__item', { 'stages__item--on': stage.highlight }]}>
            {stage.name}
          </li>
        ))
      }
    </ol>
    <div class="featured__foot">
      <p class="label">{featured.stack}</p>
      <a class="button" href={featured.ctaUrl}>
        {featured.cta} <span aria-hidden="true">→</span>
      </a>
    </div>
  </article>
  <div class="stack-col span-4 md-span-12 stats">
    {
      stats.map((stat) => (
        <div class="cell stat">
          <p class="label">{stat.label}</p>
          <p class="stat__value">{stat.value}</p>
          <p class="muted stat__caption">{stat.caption}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .featured {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .featured__meta,
  .featured__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .featured__foot {
    margin-top: auto;
    padding-top: 8px;
  }
  .featured__desc {
    max-width: 60ch;
    font-size: clamp(17px, 1.5vw, 19px);
  }

  .stages {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stages__item {
    padding: 6px 10px;
    border: var(--line) solid var(--c-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
  }
  .stages__item--on {
    background: var(--c-ink);
    color: var(--c-on-ink);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stat .label {
    margin-bottom: 12px;
  }
  .stat__value {
    font-weight: 700;
    font-size: clamp(48px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  @media (max-width: 1080px) and (min-width: 721px) {
    .stats {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: auto;
    }
  }
</style>
