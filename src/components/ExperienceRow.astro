---
import type { Content } from '../content';

interface Props {
  content: Content;
}

const { experience, stack } = Astro.props.content;
---

<section id="experience" class="row" aria-labelledby="experience-title">
  <div class="cell span-8 md-span-12">
    <h2 id="experience-title" class="label">{experience.label}</h2>
    <ol class="jobs">
      {
        experience.jobs.map((job) => (
          <li class="job">
            <p class="mono muted job__dates">{job.dates}</p>
            <div>
              <h3 class="job__title">
                {job.role} <span class="muted">· {job.company}</span>
              </h3>
              <p class="job__desc">{job.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  <aside class="cell cell--alt span-4 md-span-12 tools" aria-labelledby="tools-title">
    <h2 id="tools-title" class="label">{stack.label}</h2>
    <p class="tools__main">{stack.main}</p>
    <ul class="tools__list">
      {stack.items.map((item) => <li>{item}</li>)}
    </ul>
  </aside>
</section>

<style>
  .jobs {
    margin-top: 20px;
  }
  .job {
    display: grid;
    grid-template-columns: 13.5em minmax(0, 1fr);
    gap: 4px 24px;
    padding-block: 18px;
    border-top: var(--line) solid var(--c-line-soft);
  }
  .job:first-child {
    border-top-color: var(--c-ink);
  }
  .job__dates {
    padding-top: 3px;
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
  }
  .job__title {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .job__title .muted {
    font-weight: 500;
  }
  .job__desc {
    margin-top: 4px;
  }

  .tools {
    display: flex;
    flex-direction: column;
  }
  .tools__main {
    margin-top: 16px;
    font-weight: 700;
    font-size: clamp(72px, 9vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .tools__list {
    margin-top: 24px;
  }
  .tools__list li {
    padding-block: 10px;
    border-top: var(--line) solid var(--c-line-soft);
  }
  .tools__list li:first-child {
    border-top-color: var(--c-ink);
  }

  @media (max-width: 720px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
