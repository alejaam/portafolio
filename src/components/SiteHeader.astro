---
import { LANGS, localizePath, type Content } from '../content';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { header, lang, sections } = content;
const pathname = Astro.url.pathname;
const navItems = [sections.projects, sections.experience, sections.contact];
---

<header class="cell site-header">
  <a class="site-header__name" href={`/${lang}/`} aria-label={header.homeLabel}>{header.name}</a>
  <div class="site-header__end">
    <nav class="site-nav" aria-label={header.navLabel}>
      <ul class="site-nav__list">
        {
          navItems.map((item) => (
            <li>
              <a class="site-nav__link" href={`#${item.id}`}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="lang-switch" aria-label={header.langSwitchLabel}>
      {
        LANGS.map((l) => (
          <li>
            <a
              href={localizePath(pathname, l)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'page' : undefined}
            >
              {l.toUpperCase()}
              <span class="sr-only">{header.langNames[l]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
