---
import type { Content } from '../content';

interface Props {
  content: Content;
}

const { hero, now } = Astro.props.content;
---

<section class="row" aria-labelledby="hero-title">
  <div class="cell span-9 md-span-8 hero">
    <p class="label">{hero.label}</p>
    <h1 id="hero-title" class="title-xl hero__title">{hero.title}</h1>
    <p class="hero__intro">{hero.intro}</p>
  </div>
  <aside class="cell cell--accent span-3 md-span-4 now" aria-label={now.label}>
    <p class="label">{now.label}</p>
    <div>
      <p class="now__role">{now.role}</p>
      <p class="mono now__details">{now.details}</p>
    </div>
  </aside>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(32px, 5vw, 64px);
  }
  .hero__title {
    max-width: 15ch;
    text-wrap: balance;
  }
  .hero__intro {
    max-width: 52ch;
    font-size: clamp(17px, 1.6vw, 20px);
  }

  .now {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .now__role {
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .now__details {
    margin-top: 12px;
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
  }
</style>
