---
import '../styles/global.css';
import { LANGS, localizePath, type Content } from '../content';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { lang, meta } = content;
const pathname = Astro.url.pathname;
const skipLabel = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={localizePath(pathname, l)} />)}
    <link rel="alternate" hreflang="x-default" href={localizePath(pathname, 'es')} />
    <link
      rel="preload"
      href="/fonts/familjen-grotesk-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/familjen-grotesk-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <div class="frame">
      <slot />
    </div>
  </body>
</html>
