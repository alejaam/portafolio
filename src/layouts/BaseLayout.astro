---
import '../styles/global.css';
import { DEFAULT_LANG, LANGS, localizePath, type Content } from '../content';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { lang, meta } = content;
const pathname = Astro.url.pathname;
const { skipLabel } = meta;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={localizePath(pathname, l)} />)}
    <link rel="alternate" hreflang="x-default" href={localizePath(pathname, DEFAULT_LANG)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <div class="frame">
      <slot />
    </div>
  </body>
</html>
